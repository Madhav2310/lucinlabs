[0.000, "o", "\u001b[33m╭─\u001b[0m\u001b[33m───────\u001b[0m\u001b[33m MEDIUM: Hardcoded Secret in MCP Config: Slack Token [AG-007] \u001b[0m\u001b[33m───────\u001b[0m\u001b[33m─╮\u001b[0m\r\n\u001b[33m│\u001b[0m Agent: \u001b[1menterprise-agents\u001b[0m                                                     \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m MCP server 'slack' env var 'SLACK_BOT_TOKEN' contains a hardcoded Slack      \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m Token: xoxb****UvWx                                                          \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m Secrets in MCP config env blocks are stored in plaintext and accessible to   \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m any process that can read the config file.                                   \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mAtta"]
[0.000, "o", "ck:\u001b[0m Anyone with read access to the MCP config file                       \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m (~/.config/claude/claude_desktop_config.json or similar) can extract this    \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m credential. MCP config files are often world-readable and synced to cloud    \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m storage.                                                                     \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mBlast radius:\u001b[0m Full access to any service this Slack Token authenticates      \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m with.                                                                        \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mOWASP Agentic:\u001b[0m ASI03 Identity & Privilege Abuse                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[32mFix:\u001b[0m Use an environment variable reference instead of a hardcoded value:     \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m   \"SLACK_BOT_TOKEN\": \"${env:SLACK_BOT_TOKEN}\"                  "]
[0.000, "o", "              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m Or use a secrets manager and have the MCP server resolve the secret at       \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m runtime.                                                                     \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mLocation:\u001b[0m slack                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m╰──────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
