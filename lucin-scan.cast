[0.000, "o", "\u001b[33m╭─\u001b[0m\u001b[33m──────\u001b[0m\u001b[33m MEDIUM: Hardcoded Secret: Generic API Key Assignment [AG-007] \u001b[0m\u001b[33m───────\u001b[0m\u001b[33m─╮\u001b[0m\r\n\u001b[33m│\u001b[0m Agent: \u001b[1mdata_analyst\u001b[0m                                                          \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m Found hardcoded Generic API Key Assignment in source code: api_****def\"      \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mAttack:\u001b[0m Secrets in source code can be extracted by anyone with repo access,  \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m leaked via git history, or exposed through agent error messages. If this     \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m agent is compromised, the attacker gets these credentials.                   \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mBlast radius:\u001b[0m All resources accessible via this Generic API Key Assignment.  \u001b[33m│\u001b[0m\r\n\u001b[33m"]
[0.000, "o", "│\u001b[0m \u001b[2mOWASP Agentic:\u001b[0m ASI03 Identity & Privilege Abuse                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[32mFix:\u001b[0m Move secrets to environment variables or a secrets manager.             \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m   → Use: os.environ['API_KEY'] instead of hardcoding                         \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m   → Or: Load from .env file (excluded from version control)                  \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mLocation:\u001b[0m examples/vulnerable-agent/agent.py:42                              \u001b[33m│\u001b[0m\r\n\u001b[33m╰──────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
