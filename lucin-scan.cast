[0.000, "o", "\u001b[33m╭─\u001b[0m\u001b[33m────────\u001b[0m\u001b[33m MEDIUM: No Human Approval for Destructive Actions [AG-006] \u001b[0m\u001b[33m────────\u001b[0m\u001b[33m─╮\u001b[0m\r\n\u001b[33m│\u001b[0m Agent: \u001b[1mData Analysis Assistant\u001b[0m                                               \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m Agent 'Data Analysis Assistant' has 2 tool(s) capable of destructive actions \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m (code_interpreter, execute_shell) but no human-in-the-loop approval          \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m configured.                                                                  \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m The agent can autonomously execute, write, or delete without confirmation.   \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mAttack:\u001b[0m Without human approval gates, a prompt injection or hallucination    \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b"]
[0.000, "o", "[0m can cause irreversible damage (data deletion, unauthorized writes, system    \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m modification) with no opportunity for a human to intervene.                  \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mBlast radius:\u001b[0m All resources accessible to: code_interpreter, execute_shell.  \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m Actions are irreversible once executed.                                      \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mOWASP Agentic:\u001b[0m ASI09 Human-Agent Trust Exploitation                          \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[32mFix:\u001b[0m Add human-in-the-loop for high-risk actions:                            \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m   → LangGraph: use interrupt_before on destructive nodes                     \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m   → LangChain: use HumanApprovalCallbackHandler                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m   → General: require confirmation for write/delete/ex"]
[0.001, "o", "ecute operations        \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mLocation:\u001b[0m examples/openai-assistant/assistant.json                           \u001b[33m│\u001b[0m\r\n\u001b[33m╰──────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
