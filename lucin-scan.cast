[0.001, "o", "\u001b[33m╭─\u001b[0m\u001b[33m──────────\u001b[0m\u001b[33m MEDIUM: High-Entropy String in Secret Context [AG-007] \u001b[0m\u001b[33m──────────\u001b[0m\u001b[33m─╮\u001b[0m\r\n\u001b[33m│\u001b[0m Agent: \u001b[1mdata_analyst\u001b[0m                                                          \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m Variable assignment contains a high-entropy string (entropy: 5.34 bits/char) \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m that may be an unknown credential format: sk-p****cdef                       \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mAttack:\u001b[0m High-entropy strings in secret-named variables are likely            \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m credentials for services we don't have specific patterns for. Even unknown   \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m secret formats should be in environment variables, not source code.          \u001b[33m│\u001b[0m\r\n\u001b"]
[0.000, "o", "[33m│\u001b[0m \u001b[2mBlast radius:\u001b[0m Unknown — depends on what service this credential accesses.    \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mOWASP Agentic:\u001b[0m ASI03 Identity & Privilege Abuse                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[32mFix:\u001b[0m Move to environment variable or secrets manager.                        \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m If this is NOT a secret, rename the variable to avoid confusion.             \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mLocation:\u001b[0m examples/vulnerable-agent/agent.py:42                              \u001b[33m│\u001b[0m\r\n\u001b[33m╰──────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "\u001b[33m╭─\u001b[0m\u001b[33m───────────────\u001b[0m\u001b[33m MEDIUM: Unauthenticated MCP Server [AG-003] \u001b[0m\u001b[33m────────────────\u001b[0m\u001b[33m─╮\u001b[0m\r\n\u001b[33m│\u001b[0m Agent: \u001b[1mvulnerable-agent\u001b[0m                                                      \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m MCP server 'filesystem' (stdio transport) has no authentication configured.  \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m Exposes 3 tool(s) to any connecting client.                                  \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mAttack:\u001b[0m Any process on the same machine (for stdio) or any network client    \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m (for HTTP/SSE) can connect and invoke all exposed tools. NSA guidance (May   \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m 2026) explicitly warns against this configuration.                    "]
[0.000, "o", "       \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mBlast radius:\u001b[0m All 3 tools on server 'filesystem' accessible without          \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m credentials.                                                                 \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mOWASP Agentic:\u001b[0m ASI03 Identity & Privilege Abuse                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[32mFix:\u001b[0m Enable OAuth 2.1 authentication on this MCP server.                     \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m   See:                                                                       \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m https://modelcontextprotocol.io/specification/2025-11-25/basic/transports    \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m   Minimum: Add client certificate validation or API key requirement.         \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mLocation:\u001b[0m examples/vulnerable-agent/mcp.json                                 \u001b[33m│\u001b[0m\r\n\u001b[33m╰────────"]
[0.000, "o", "──────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
