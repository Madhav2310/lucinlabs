[0.000, "o", "\u001b[33m╭─\u001b[0m\u001b[33m─────────\u001b[0m\u001b[33m MEDIUM: Cross-Origin Escalation: github × slack [AG-024] \u001b[0m\u001b[33m─────────\u001b[0m\u001b[33m─╮\u001b[0m\r\n\u001b[33m│\u001b[0m Agent: \u001b[1menterprise-agents\u001b[0m                                                     \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m MCP servers 'github' (read) and 'slack' (network) create a cross-origin      \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m escalation path:                                                             \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m Data from Server A can be exfiltrated via Server B's network tool            \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mAttack:\u001b[0m Cross-origin trust boundary violation via confused deputy pattern.   \u001b[33m│\u001b[0m\r\n\u001b[33"]
[0.000, "o", "m│\u001b[0m \u001b[2mBlast radius:\u001b[0m Resources of both servers exposed.                             \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mOWASP Agentic:\u001b[0m ASI07 Insecure Inter-Agent Communication · ASI03 Identity &   \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m Privilege Abuse                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[32mFix:\u001b[0m Separate these servers into different agents with distinct scopes.      \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mLocation:\u001b[0m examples/enterprise-agents/mcp.json                                \u001b[33m│\u001b[0m\r\n\u001b[33m╰──────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
