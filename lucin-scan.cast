[0.000, "o", "\u001b[33m╭─\u001b[0m\u001b[33m────────────\u001b[0m\u001b[33m MEDIUM: Code Execution + Network Access [AG-005b] \u001b[0m\u001b[33m─────────────\u001b[0m\u001b[33m─╮\u001b[0m\r\n\u001b[33m│\u001b[0m Agent: \u001b[1magent\u001b[0m                                                                 \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m Agent can execute code AND access network — enables reverse shell or C2.     \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m Tools involved: run_python, search_web                                       \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mAttack:\u001b[0m Combined capabilities  enable attack chains that individual tools    \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m cannot perform alone.                                                        \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mBlast radius:\u001b[0m Depends on scope of individual tool permissions.          "]
[0.000, "o", "     \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mOWASP Agentic:\u001b[0m ASI02 Tool Misuse & Exploitation                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m                                                                              \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[32mFix:\u001b[0m Separate these capabilities into different agents with distinct         \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m permission scopes, or add explicit approval gates between operations that    \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m combine these capabilities.                                                  \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2mLocation:\u001b[0m examples/real-world-pattern/agent.py                               \u001b[33m│\u001b[0m\r\n\u001b[33m╰──────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
